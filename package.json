{
  "name": "struct-launcher",
  "version": "0.2.3",
  "private": true,
  "description": "A casa dos seus aplicativos de engenharia. Launcher desktop do ecossistema OpenStruct.",
  "type": "module",
  "license": "MIT",
  "author": "Ricardo Corsini e colaboradores",
  "repository": "github:ricardocorsini/launcher-struct",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b && vitest run && node --test scripts/security.test.mjs scripts/distribution/release.test.mjs scripts/distribution/source.test.mjs scripts/distribution/hub.test.mjs scripts/distribution/product-files.test.mjs scripts/distribution/request-release.test.mjs && node scripts/validate-catalog.mjs catalog/bundled.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:core": "cargo test -p launcher-core --locked",
    "test:e2e": "playwright test",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "keys:generate": "node scripts/keys.mjs",
    "catalog:sign": "node scripts/sign-catalog.mjs",
    "package:sign": "node scripts/sign-package.mjs",
    "distribution:init": "node scripts/distribution/init.mjs",
    "release:version": "node scripts/openstruct-version.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.8.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
